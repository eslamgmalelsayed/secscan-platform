# Copy to .env (git-ignored) and adjust. Values below are LOCAL DEV ONLY.

# --- storage (docker compose up -d postgres redis mailpit) ---
DATABASE_URL=postgresql://secscan:secscan_dev_only@localhost:5432/secscan
REDIS_URL=redis://localhost:6379

# --- API ---
PORT=3001
SECSCAN_BIND=127.0.0.1
# Hosts you own and may test while the legal lock (§3.2) is on. CSV.
SECSCAN_LAB_HOSTS=
# true only if a lab target lives on a private address (e.g. 192.168.x.x)
SECSCAN_ALLOW_PRIVATE_TARGETS=false
# true enables the one-step POST /scans/quick (paste a URL, auto-grant + crawl +
# scan) with no auth and the lab lock bypassed for the pasted host. Loopback only
# — the API refuses to start in this mode on a non-loopback bind. Testers only.
SECSCAN_DEV_TRUST=false
# Test-account material for your test users; kept in memory, never served.
SECSCAN_IDENTITIES_FILE=

# --- auth: generate each secret with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# name:token pairs; the name becomes the audit-log actor
SECSCAN_API_TOKENS=
SECSCAN_ADMIN_TOKEN=
SECSCAN_FINGERPRINT_SECRET=

# --- owner sign-off mail (Mailpit locally; inbox at http://127.0.0.1:8025) ---
SECSCAN_SMTP_URL=smtp://127.0.0.1:1025
SECSCAN_MAIL_FROM=secscan@localhost

# --- tests against real services (optional) ---
SECSCAN_TEST_DATABASE_URL=postgresql://secscan:secscan_dev_only@localhost:5432/secscan_test
SECSCAN_TEST_REDIS_URL=redis://127.0.0.1:6379

# Queue mode (review gap 1): set a Redis URL to run scans on a worker instead
# of inline in the API. Requires DATABASE_URL too (API and worker share state
# through Postgres). Start the worker with: npm run start:worker -w @secscan/api
SECSCAN_REDIS_URL=redis://127.0.0.1:6379

# Assessment project storage in the single-process console (default ~/.secscan/projects).
SECSCAN_PROJECT_DIR=
# Optional OIDC login for assessment projects. Use the dedicated API audience.
SECSCAN_OIDC_ISSUER=
SECSCAN_OIDC_JWKS=
SECSCAN_OIDC_AUDIENCE=
SECSCAN_OIDC_CLIENT_ID=
SECSCAN_OIDC_SCOPE=
# Optional private S3-compatible bucket for redacted text evidence.
SECSCAN_EVIDENCE_BUCKET=
SECSCAN_S3_ENDPOINT=
AWS_REGION=
