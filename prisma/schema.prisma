// Postgres persistence (Design §4). Implements the same interfaces as the
// API's in-memory repositories: packages/api/src/persistence/prismaStores.ts.
// Connection URL lives in prisma.config.ts (Prisma 7). Apply locally with:
//   npm run db:migrate

generator client {
  provider     = "prisma-client"
  output       = "../packages/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum GrantStatus {
  pending_owner
  active
  expired
  revoked
}

enum Environment {
  staging
  production
  lab
}

model Grant {
  id                 String       @id // grantId
  ownershipProof     String
  ownershipToken     String
  ownershipVerified  Boolean      @default(false)
  ownershipMethod    String? // "automatic" | "manual"
  adminApproved      Boolean      @default(false)
  status             GrantStatus  @default(pending_owner)
  notBefore          DateTime
  notAfter           DateTime
  allowStateChanging Boolean      @default(false)
  targets            Target[]
  chain              ChainLink[]
  scans              Scan[]
  audit              AuditEntry[]
  challenges         OwnerChallenge[]
  createdAt          DateTime     @default(now())
}

model Target {
  id       String @id @default(cuid())
  position Int
  host     String
  scheme   String @default("https")
  port     Int?
  grant    Grant  @relation(fields: [grantId], references: [id])
  grantId  String

  @@unique([grantId, position])
}

model ChainLink {
  id        String   @id @default(cuid())
  position  Int
  party     String
  email     String
  role      String // requester | system_owner | platform_owner
  statement String
  signedAt  DateTime
  grant     Grant    @relation(fields: [grantId], references: [id])
  grantId   String

  @@unique([grantId, position])
}

// Pending owner sign-off codes. Only an HMAC of the code is stored.
model OwnerChallenge {
  id        String   @id
  grant     Grant    @relation(fields: [grantId], references: [id])
  grantId   String
  party     String
  email     String
  statement String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)

  @@index([grantId])
}

model Engagement {
  id               String      @id
  client           String
  preparedBy       String
  environment      Environment
  authorizationRef String
  windowStart      DateTime
  windowEnd        DateTime
  assets           String[]
  methodologyAr    String
  methodologyEn    String
  limitationsAr    String
  limitationsEn    String
}

model Scan {
  id           String    @id
  // Plain reference: a scan record is kept even if its engagement is created later.
  engagementId String
  grant        Grant     @relation(fields: [grantId], references: [id])
  grantId      String
  status       String // queued | running | done | failed
  notTested    String[]
  telemetry    Json?
  findings     Finding[]
  createdAt    DateTime

  @@index([engagementId])
}

// Mirrors @secscan/shared Finding (zod). `id` is deterministic per finding,
// so the primary key is (scanId, id). `reviewQueue` marks findings kept for
// human review rather than the client report. `position` preserves order.
model Finding {
  id            String
  scan          Scan    @relation(fields: [scanId], references: [id])
  scanId        String
  position      Int
  reviewQueue   Boolean @default(false)
  severity      String
  cvssScore     Float?
  cvssVector    String?
  confidence    String // confirmed | likely | needs_review
  status        String  @default("open")
  asset         String
  location      String?
  titleAr       String
  titleEn       String
  descriptionAr String
  descriptionEn String
  impactAr      String
  impactEn      String
  remediationAr String
  remediationEn String
  evidence      Json
  controls      Json
  retests       Json    @default("[]")
  source        String
  firstSeen     DateTime

  @@id([scanId, id])
}

// Append-only: the application only INSERTs and SELECTs here. A trigger in
// the migration rejects UPDATE and DELETE at the database level too.
model AuditEntry {
  id      String   @id @default(cuid())
  seq     Int      @default(autoincrement())
  at      DateTime @default(now())
  actor   String
  action  String
  detail  String?
  grant   Grant?   @relation(fields: [grantId], references: [id])
  grantId String?

  @@index([grantId, seq])
}
